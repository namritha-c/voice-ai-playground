{
  "id": "openai",
  "name": "OpenAI",
  "mono": "Oa",
  "env": ["OPENAI_API_KEY"],
  "modes": {
    "tts": {
      "tag": "Steerable TTS",
      "max_chars": 4096,
      "models": ["gpt-4o-mini-tts", "tts-1", "tts-1-hd"],
      "voices": {"source": "static", "items": [
        {"id": "alloy", "name": "Alloy", "desc": "Neutral"},
        {"id": "ash", "name": "Ash", "desc": "Warm"},
        {"id": "ballad", "name": "Ballad", "desc": "Gentle", "models": ["gpt-4o-mini-tts"]},
        {"id": "coral", "name": "Coral", "desc": "Bright"},
        {"id": "echo", "name": "Echo", "desc": "Clear · male"},
        {"id": "fable", "name": "Fable", "desc": "Storyteller"},
        {"id": "onyx", "name": "Onyx", "desc": "Deep · male"},
        {"id": "nova", "name": "Nova", "desc": "Bright · female"},
        {"id": "sage", "name": "Sage", "desc": "Calm"},
        {"id": "shimmer", "name": "Shimmer", "desc": "Soft · female"},
        {"id": "verse", "name": "Verse", "desc": "Expressive", "models": ["gpt-4o-mini-tts"]}
      ]},
      "params": [
        {"key": "instructions", "label": "Voice instructions", "type": "text", "placeholder": "e.g. Speak warmly, like a friendly receptionist", "default": "", "models": ["gpt-4o-mini-tts"]},
        {"key": "speed", "label": "Speed", "type": "range", "min": 0.25, "max": 4, "step": 0.05, "default": 1, "unit": "×"},
        {"key": "response_format", "label": "Format", "type": "enum", "options": ["mp3", "opus", "wav", "aac", "flac"], "default": "mp3"}
      ]
    },
    "stt": {
      "tag": "Transcription",
      "models": ["gpt-4o-transcribe", "gpt-4o-mini-transcribe", "whisper-1"],
      "params": [
        {"key": "language", "label": "Language", "type": "enum", "options": ["auto", "en", "hi", "ml", "ta", "es", "fr", "de"], "default": "auto", "promote": true},
        {"key": "temperature", "label": "Temperature", "type": "range", "min": 0, "max": 1, "step": 0.1, "default": 0},
        {"key": "prompt", "label": "Context prompt", "type": "text", "placeholder": "Names, jargon or spelling hints", "default": ""}
      ]
    },
    "sts": {
      "tag": "Realtime · speech in, speech out",
      "models": ["gpt-realtime", "gpt-4o-realtime-preview", "gpt-4o-mini-realtime-preview"],
      "voices": {"source": "static", "items": [
        {"id": "alloy", "name": "Alloy", "desc": "Neutral"},
        {"id": "ash", "name": "Ash", "desc": "Warm"},
        {"id": "ballad", "name": "Ballad", "desc": "Gentle"},
        {"id": "coral", "name": "Coral", "desc": "Bright"},
        {"id": "sage", "name": "Sage", "desc": "Calm"},
        {"id": "verse", "name": "Verse", "desc": "Expressive"}
      ]},
      "params": [
        {"key": "instructions", "label": "System instructions", "type": "text", "placeholder": "How the assistant should respond", "default": "You are a helpful voice assistant. Reply briefly and naturally."},
        {"key": "temperature", "label": "Temperature", "type": "range", "min": 0.6, "max": 1.2, "step": 0.05, "default": 0.8}
      ]
    }
  }
}
