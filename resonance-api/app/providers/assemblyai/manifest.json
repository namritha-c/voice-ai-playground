{
  "id": "assemblyai",
  "name": "AssemblyAI",
  "mono": "Aa",
  "env": ["ASSEMBLYAI_API_KEY"],
  "modes": {
    "stt": {
      "tag": "Universal ASR",
      "models": ["universal", "slam-1"],
      "params": [
        {"key": "language", "label": "Language", "type": "enum", "options": ["auto", "en", "en_us", "hi", "es", "fr", "de"], "default": "auto", "promote": true},
        {"key": "speaker_labels", "label": "Speaker labels", "type": "bool", "default": false},
        {"key": "punctuate", "label": "Punctuation", "type": "bool", "default": true},
        {"key": "format_text", "label": "Format text", "type": "bool", "default": true},
        {"key": "disfluencies", "label": "Keep filler words", "type": "bool", "default": false}
      ]
    }
  }
}
