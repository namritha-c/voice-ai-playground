# Copy to .env and fill in the keys you have. Providers without keys show "NO KEY".
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
ASSEMBLYAI_API_KEY=

# Azure Speech — key + region (e.g. centralindia, eastus)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud — path to a service-account JSON with Text-to-Speech + Speech-to-Text enabled
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PROJECT_ID=
GOOGLE_STT_LOCATION=us-central1

# Where the SQLite DB and audio files go (default: ./data)
# DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
